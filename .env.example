# ---------------------------------------------------------------------------
# Pick ONE provider and set its variables in the Vercel project
# (Settings → Environment Variables). If both are set, Brevo is used.
# Never commit real keys — this file is only a template.
# ---------------------------------------------------------------------------

# --- Option A: Brevo (recommended — unlimited contacts on the free tier) ----
# API key: Brevo → your name (top right) → SMTP & API → API Keys → Generate
BREVO_API_KEY=
# Optional. Brevo → Contacts → Lists — the numeric id of the list to add to.
BREVO_LIST_ID=

# --- Option B: Mailchimp ----------------------------------------------------
# API key: Mailchimp → Account → Extras → API keys. Keep the "-us21" suffix.
MAILCHIMP_API_KEY=
# Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_AUDIENCE_ID=
# Set to "true" to send a confirmation email before subscribing (double opt-in)
MAILCHIMP_DOUBLE_OPT_IN=false
